{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/v1",
    "DefaultModel": "qwen3:8b",
    "Temperature": 0.7
  },
  "ResourceLimits": {
    "MaxTotalAgents": 50,
    "MaxSupremeAgents": 1,
    "MaxPrinceAgents": 3,
    "MaxDukeAgents": 10,
    "MaxWorkerAgents": 30,
    "MaxMemoryDecisions": 5000,
    "MaxMemoryFacts": 25000,
    "MaxMemoryTasks": 5000,
    "MaxMessageQueueSize": 500,
    "MaxConcurrentToolExecutions": 5,
    "MaxDatabaseSizeBytes": 500000000,
    "MaxToolExecutionTimeSeconds": 180,
    "MaxLlmCallTimeSeconds": 45
  },
  "AutonomyReadiness": {
    "Enabled": true,
    "FailStartupOnCriticalNotReady": true,
    "CatalogVersion": "2026.08",
    "CriticalCapabilities": [
      "request_collaboration",
      "workflow_step",
      "email_inbox_query",
      "email_send",
      "send_telegram"
    ]
  }
}
