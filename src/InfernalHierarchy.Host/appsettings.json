{
  "Http": {
    "Enabled": true,
    "Urls": "http://localhost:5080"
  },
  "Ui": {
    "Enabled": true,
    "LocalOnly": true
  },
  "OperatorApi": {
    "Enabled": false,
    "ApiKey": ""
  },
  "WebSockets": {
    "Enabled": true,
    "LocalOnly": true,
    "MaxClientMessageBytes": 65536,
    "KeepAliveSeconds": 30
  },
  "OpenTelemetry": {
    "Exporters": {
      "Console": {
        "Enabled": true
      },
      "Otlp": {
        "Enabled": false,
        "Endpoint": "http://localhost:4317"
      }
    }
  },
  "Perf": {
    "RequestProfiling": {
      "Enabled": true,
      "MaxRecords": 500,
      "RetentionMinutes": 30,
      "IncludeUiRequests": false
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/infernal-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/v1",
    "DefaultModel": "deepseek-r1:8b",
    "AlternativeModel": "qwen2.5:8b",
    "MaxTokens": 4096,
    "Temperature": 0.7
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUserIds": []
  },
  "TelegramVoice": {
    "Enabled": false,
    "ReplyWithVoice": false,
    "MaxAudioBytes": 10485760,
    "WorkingDirectory": "data/voice/telegram",
    "TranscribeToolName": "audio_transcribe",
    "SpeakToolName": "tts_speak"
  },
  "Voice": {
    "Enabled": false,
    "LocalOnly": true,
    "MaxUploadBytes": 10485760
  },
  "VoiceTranscription": {
    "Enabled": false,
    "ExecutablePath": "",
    "RootDirectory": "data/voice",
    "Arguments": [],
    "TimeoutMs": 180000,
    "MaxOutputBytes": 65536,
    "MaxInputBytes": 26214400,
    "AllowedExtensions": [ ".ogg", ".wav", ".mp3", ".m4a", ".mp4" ]
  },
  "TextToSpeech": {
    "Enabled": false,
    "UsePiperNet": true,
    "PiperVoicePath": "",
    "PiperSpeakerId": 0,
    "PiperSpeed": 1.0,
    "PiperThreadCount": 0,
    "PiperWarmupOnLoad": true,
    "PiperWarmupAtStartup": false,
    "ExecutablePath": "",
    "RootDirectory": "data/voice",
    "Arguments": [],
    "TimeoutMs": 180000,
    "MaxOutputBytes": 65536,
    "MaxTextChars": 5000,
    "OutputExtension": ".wav"
  },
  "SearXNG": {
    "BaseUrl": "http://localhost:8080",
    "Enabled": true
  },
  "BraveSearch": {
    "ApiKey": "",
    "Enabled": true
  },
  "Memory": {
    "DatabasePath": "data/infernal.db"
  },
  "Hierarchy": {
    "MaxAgentDepth": 4,
    "MainAgentName": "Lucifer",
    "MainAgentPersonaPath": "souls/lucifer.json"
  },
  "ResourceLimits": {
    "MaxSupremeAgents": 1,
    "MaxPrinceAgents": 5,
    "MaxDukeAgents": 20,
    "MaxWorkerAgents": 50,
    "MaxTotalAgents": 100,
    "MaxAgentDepth": 4,
    "MaxMemoryDecisions": 10000,
    "MaxMemoryFacts": 50000,
    "MaxMemoryTasks": 10000,
    "MaxMessageQueueSize": 1000,
    "MaxConcurrentToolExecutions": 10,
    "MaxDatabaseSizeBytes": 1000000000,
    "MaxToolExecutionTimeSeconds": 300,
    "MaxLlmCallTimeSeconds": 60
  },
  "ToolPermissions": {
    "create_sub_agent": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "web_search": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "write_memory": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "read_memory": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "telegram_send": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "audio_transcribe": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "tts_speak": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    }
  },
  "ToolRateLimiting": {
    "Enabled": false,
    "DefaultRule": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "RankDefaults": {
      "Worker": { "PermitLimit": 30, "WindowSeconds": 60 },
      "Duke": { "PermitLimit": 60, "WindowSeconds": 60 },
      "Prince": { "PermitLimit": 120, "WindowSeconds": 60 },
      "Supreme": { "PermitLimit": 300, "WindowSeconds": 60 }
    },
    "Tools": {
      "web_search": {
        "DefaultRule": { "PermitLimit": 10, "WindowSeconds": 60 }
      }
    },
    "IdleEntryExpirationSeconds": 600,
    "PruneEveryNChecks": 500
  },
  "CustomTools": {
    "Enabled": true,
    "ApprovedToolIds": [],
    "ApprovedToolNames": [],
    "AllowUnsafeWithoutManualApproval": false
  },
  "LlmOptions": {
    "Models": [
      {
        "Name": "llama3.1:8b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Medium",
        "Priority": 1,
        "Temperature": 0.7,
        "MaxTokens": 2048
      },
      {
        "Name": "gemma:2b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Simple",
        "Priority": 1,
        "Temperature": 0.5,
        "MaxTokens": 1024
      },
      {
        "Name": "qwen:32b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Complex",
        "Priority": 1,
        "Temperature": 0.8,
        "MaxTokens": 4096
      },
      {
        "Name": "deepseek-coder:6.7b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Expert",
        "Priority": 1,
        "Temperature": 0.3,
        "MaxTokens": 2048
      }
    ]
  },
    "GitHubPublisher": {
      "Enabled": false,
      "Owner": "",
      "Repository": "infernal-custom-tools",
      "Branch": "main",
      "RootPath": "tools",
      "Token": "",
      "CreateRepoIfMissing": true
    },
  "VectorMemoryOptions": {
    "QdrantUrl": "http://localhost:6333",
    "CollectionName": "infernal_facts",
    "VectorDimensions": 384,
    "Enabled": true
  },
  "OnnxEmbeddingOptions": {
    "Enabled": false,
    "ModelPath": "./models/sentence-transformers/model.onnx",
    "TokenizerPath": "./models/sentence-transformers/tokenizer.json",
    "MaxSequenceLength": 128,
    "EmbeddingDimension": 384
  },
  "MemoryPruningOptions": {
    "Enabled": false,
    "PruningIntervalHours": 24,
    "DryRun": true,
    "MaxDeletesPerRun": 500,
    "RetentionDays": 30,
    "MinConfidenceThreshold": 0.3,
    "EnableArchival": false,
    "ArchivePath": "./archive/memory",
    "DecisionsToScan": 1000
  },
  "RagOptions": {
    "Enabled": true,
    "MaxFacts": 6,
    "MinScore": 0.7,
    "MaxCharsPerFact": 320
  },
  "ReActOptions": {
    "UseJsonResponse": true
  },
  "MemoryLearningOptions": {
    "Enabled": false,
    "IntervalMinutes": 60,
    "MaxFactsPerRun": 50,
    "EnableCompression": true,
    "CompressIfLongerThanChars": 1200,
    "CompressToMaxChars": 500,
    "EnableClustering": true,
    "MinClusterSize": 3,
    "ClusterSimilarityThreshold": 0.86,
    "SummaryCategory": "cluster_summary",
    "SummaryMaxChars": 800
  }
}
