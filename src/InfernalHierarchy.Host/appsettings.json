{
  "Http": {
    "Enabled": true,
    "Urls": "http://localhost:5080"
  },
  "Ui": {
    "Enabled": true,
    "LocalOnly": true
  },
  "OperatorApi": {
    "Enabled": false,
    "ApiKey": ""
  },
  "WebSockets": {
    "Enabled": true,
    "LocalOnly": true,
    "MaxClientMessageBytes": 65536,
    "KeepAliveSeconds": 30
  },
  "OpenTelemetry": {
    "Exporters": {
      "Console": {
        "Enabled": true
      },
      "Otlp": {
        "Enabled": false,
        "Endpoint": "http://localhost:4317"
      }
    }
  },
  "Perf": {
    "RequestProfiling": {
      "Enabled": true,
      "MaxRecords": 500,
      "RetentionMinutes": 30,
      "IncludeUiRequests": false
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/infernal-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/v1",
    "DefaultModel": "qwen3:8b",
    "AlternativeModel": "dolphin3:8b",
    "RequestTimeoutSeconds": 600,
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "EnableModelRoutingPolicy": false,
    "EnableAdaptiveRoutingFeedback": true,
    "EnablePromptCompaction": true,
    "PromptCompactionMaxChars": 12000,
    "PromptCompactionHeadChars": 7000,
    "PromptCompactionTailChars": 4000,
    "ModelRoutes": [
      {
        "TaskType": "voice",
        "MaxLatencyMs": 1500,
        "Model": "gemma:2b",
        "Priority": 10
      },
      {
        "TaskType": "voice",
        "MaxLatencyMs": 0,
        "Model": "qwen3:8b",
        "Priority": 20
      }
    ]
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUserIds": []
  },
  "TelegramVoice": {
    "Enabled": false,
    "ReplyWithVoice": false,
    "MaxAudioBytes": 10485760,
    "WorkingDirectory": "data/voice/telegram",
    "TranscribeToolName": "audio_transcribe",
    "SpeakToolName": "tts_speak"
  },
  "Voice": {
    "Enabled": false,
    "LocalOnly": true,
    "MaxUploadBytes": 10485760
  },
  "VoiceTranscription": {
    "Enabled": false,
    "UseSidecar": false,
    "SidecarBaseUrl": "http://localhost:5091",
    "SidecarTranscribePath": "/transcribe",
    "SidecarTimeoutMs": 120000,
    "ExecutablePath": "",
    "RootDirectory": "data/voice",
    "Arguments": [],
    "TimeoutMs": 180000,
    "MaxOutputBytes": 65536,
    "MaxInputBytes": 26214400,
    "AllowedExtensions": [ ".ogg", ".wav", ".mp3", ".m4a", ".mp4" ]
  },
  "TextToSpeech": {
    "Enabled": false,
    "UseSidecar": false,
    "SidecarBaseUrl": "http://localhost:5091",
    "SidecarSpeakPath": "/speak",
    "SidecarTimeoutMs": 120000,
    "UsePiperNet": true,
    "EnableLanguageVoiceSelection": true,
    "PiperVoicePath": "",
    "FrenchPiperVoicePath": "",
    "PiperSpeakerId": 0,
    "FrenchPiperSpeakerId": null,
    "PiperSpeed": 1.0,
    "PiperThreadCount": 0,
    "PiperWarmupOnLoad": true,
    "PiperWarmupAtStartup": false,
    "ExecutablePath": "",
    "RootDirectory": "data/voice",
    "Arguments": [],
    "TimeoutMs": 180000,
    "MaxOutputBytes": 65536,
    "MaxTextChars": 5000,
    "OutputExtension": ".wav"
  },
  "Vision": {
    "Enabled": false,
    "RootDirectory": "data/vision",
    "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".webp" ],
    "MaxInputBytes": 10485760,
    "TimeoutMs": 90000,
    "MaxOutputChars": 20000,
    "DefaultPrompt": "Describe the image, identify key elements, and answer the user question precisely.",
    "DefaultModel": ""
  },
  "SearXNG": {
    "BaseUrl": "http://localhost:8080",
    "Enabled": true
  },
  "BraveSearch": {
    "ApiKey": "",
    "Enabled": true
  },
  "Memory": {
    "DatabasePath": "data/infernal.db"
  },
  "Hierarchy": {
    "MaxAgentDepth": 4,
    "MainAgentName": "Lucifer",
    "MainAgentPersonaPath": "souls/lucifer.json"
  },
  "SkillsCatalog": {
    "DirectoryPath": "skills"
  },
  "AgentSkillAssignment": {
    "Enabled": true,
    "AutoAssignBaseSkills": true,
    "AutoApproveEscalationsByMainAgent": true,
    "MainAgentId": "lucifer",
    "AllowSelfServiceSkillRequests": true,
    "EscalateRiskLevelAtOrAbove": "High",
    "SelfServiceAllowedRanks": [ "Supreme", "Prince", "Duke" ],
    "SupremeBaseSkillPacks": [ "core-orchestrator" ],
    "PrinceBaseSkillPacks": [ "team-coordination" ],
    "DukeBaseSkillPacks": [ "implementation-engineering" ],
    "WorkerBaseSkillPacks": [ "execution-worker" ],
    "PersistRuntimeGrants": true,
    "RuntimeGrantDatabasePath": "data/agent-skill-runtime.db",
    "RuntimeGrantMaxEntries": 20000
  },
  "SkillbookPublishing": {
    "Enabled": true,
    "DirectoryPath": "skills/runtime",
    "DatabasePath": "data/skillbook.db",
    "PromotionMinSuccessCount": 3,
    "MaxEntries": 10000
  },
  "ExecutionProfiles": {
    "Enabled": true,
    "DefaultProfile": "Research",
    "Profiles": {
      "Research": {
        "Enabled": true,
        "AllowedTools": [ "web_search", "read_memory", "write_memory", "request_collaboration", "get_agent_status", "request_skill_pack", "create_sub_agent", "send_agent_message", "create_agent_from_template", "list_templates", "email_send", "email_inbox_query", "send_telegram", "vision_describe", "audio_transcribe", "tts_speak", "repo_analyze" ],
        "DeniedTools": [ "fs_write", "python_exec", "node_exec" ],
        "AllowedFileScopes": [],
        "AllowedNetworkScopes": [],
        "CommandAllowlist": []
      },
      "Build": {
        "Enabled": true,
        "AllowedTools": [ "web_search", "read_memory", "write_memory", "request_collaboration", "get_agent_status", "request_skill_pack", "fs_read", "fs_search", "fs_write", "http_request", "graphql_request", "sql_query_readonly", "python_exec", "node_exec", "create_custom_tool", "custom_tool_list", "custom_tool_get_source", "custom_tool_delete", "vision_describe", "audio_transcribe", "repo_analyze", "workflow_step" ],
        "DeniedTools": [],
        "AllowedFileScopes": [ "*" ],
        "AllowedNetworkScopes": [ "*" ],
        "CommandAllowlist": []
      },
      "Deploy": {
        "Enabled": true,
        "AllowedTools": [ "web_search", "read_memory", "write_memory", "request_collaboration", "get_agent_status", "request_skill_pack", "fs_read", "fs_search", "http_request", "python_exec", "node_exec", "create_custom_tool", "custom_tool_list", "custom_tool_get_source", "repo_analyze", "workflow_step", "deploy_adapter" ],
        "DeniedTools": [ "fs_write", "custom_tool_delete" ],
        "AllowedFileScopes": [ "*" ],
        "AllowedNetworkScopes": [ "*" ],
        "CommandAllowlist": []
      }
    }
  },
  "ResourceLimits": {
    "MaxSupremeAgents": 1,
    "MaxPrinceAgents": 5,
    "MaxDukeAgents": 20,
    "MaxWorkerAgents": 50,
    "MaxTotalAgents": 100,
    "MaxAgentDepth": 4,
    "MaxMemoryDecisions": 10000,
    "MaxMemoryFacts": 50000,
    "MaxMemoryTasks": 10000,
    "MaxMessageQueueSize": 1000,
    "MaxConcurrentToolExecutions": 10,
    "MaxDatabaseSizeBytes": 1000000000,
    "MaxToolExecutionTimeSeconds": 300,
    "MaxLlmCallTimeSeconds": 60
  },
  "MessageBus": {
    "QueueCapacity": 1000,
    "OverflowPolicy": "Block",
    "Backpressure": {
      "Enabled": true,
      "HighWatermarkRatio": 0.85,
      "RecoverWatermarkRatio": 0.55,
      "DeferCollaborationRequests": true,
      "DeferToolExecutions": true,
      "ToolRetryAfterMs": 1500,
      "DeferredToolNames": [ "request_collaboration", "create_sub_agent", "send_agent_message" ]
    }
  },
  "FailedOperations": {
    "Enabled": true,
    "ReplayRetryBudget": 3,
    "MaxEntries": 5000,
    "DatabasePath": "data/failed-operations.db",
    "AutonomousReplayEnabled": true,
    "ReplayBatchSize": 20,
    "ReplayPollIntervalMs": 2000,
    "ReplayInitialBackoffMs": 250,
    "ReplayMaxBackoffMs": 30000,
    "ReplayJitterRatio": 0.15,
    "ReplayMaxAttemptsPerLoop": 10
  },
  "AutonomousIncidentResponse": {
    "Enabled": true,
    "PollInterval": "00:00:10",
    "ActionCooldown": "00:00:30",
    "ToolTimeoutSpikeThreshold": 3,
    "QueueRejectGrowthThreshold": 5,
    "StalledBranchDetectionThreshold": 2,
    "LoopingBranchDetectionThreshold": 2,
    "RootAgentId": "lucifer",
    "EnableBranchPreemption": true,
    "EnableTemporaryRateReduction": true,
    "RateReductionDuration": "00:01:00",
    "RateReductionRetryAfterMs": 2000,
    "DeferredToolNames": [ "request_collaboration", "create_sub_agent", "send_agent_message" ],
    "EmitAuditEvents": true
  },
  "AgentSupervisor": {
    "Enabled": true,
    "PollInterval": "00:00:15",
    "MaxStallDuration": "00:02:00",
    "MaxNoProgressTicks": 8,
    "InterventionCooldown": "00:01:00",
    "PreemptEnabled": true,
    "DecisionLookbackCount": 50
  },
  "DeliveryWorkflow": {
    "Enabled": true,
    "RootDirectory": "../..",
    "DefaultTimeoutMs": 180000,
    "MaxOutputBytes": 524288,
    "MaxDiscoveryFiles": 8000,
    "PackageOutputDirectory": "artifacts",
    "Adapters": {
      "sandbox-local": {
        "Enabled": true,
        "WorkingDirectory": ".",
        "AllowedEnvironments": [ "sandbox", "staging" ],
        "DeployExecutable": "dotnet",
        "DeployArguments": [ "test", "InfernalHierarchy.sln", "-c", "Release", "--no-build" ],
        "RollbackExecutable": "dotnet",
        "RollbackArguments": [ "build", "InfernalHierarchy.sln", "-c", "Release" ]
      }
    }
  },
