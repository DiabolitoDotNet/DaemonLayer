{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/infernal-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/v1",
    "DefaultModel": "deepseek-r1:8b",
    "AlternativeModel": "qwen2.5:8b",
    "MaxTokens": 4096,
    "Temperature": 0.7
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUserIds": []
  },
  "SearXNG": {
    "BaseUrl": "http://localhost:8080",
    "Enabled": true
  },
  "BraveSearch": {
    "ApiKey": "",
    "Enabled": true
  },
  "Memory": {
    "DatabasePath": "data/infernal.db"
  },
  "Hierarchy": {
    "MaxAgentDepth": 4,
    "MainAgentName": "Lucifer",
    "MainAgentPersonaPath": "souls/lucifer.json"
  },
  "ResourceLimits": {
    "MaxSupremeAgents": 1,
    "MaxPrinceAgents": 5,
    "MaxDukeAgents": 20,
    "MaxWorkerAgents": 50,
    "MaxTotalAgents": 100,
    "MaxAgentDepth": 4,
    "MaxMemoryDecisions": 10000,
    "MaxMemoryFacts": 50000,
    "MaxMemoryTasks": 10000,
    "MaxMessageQueueSize": 1000,
    "MaxConcurrentToolExecutions": 10,
    "MaxDatabaseSizeBytes": 1000000000,
    "MaxToolExecutionTimeSeconds": 300,
    "MaxLlmCallTimeSeconds": 60
  },
  "ToolPermissions": {
    "create_sub_agent": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "web_search": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "write_memory": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "read_memory": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    },
    "telegram_send": {
      "Enabled": true,
      "AllowedRanks": "Supreme,Prince,Duke,Worker",
      "WhitelistedAgents": [],
      "BlacklistedAgents": []
    }
  },
  "LlmOptions": {
    "Models": [
      {
        "Name": "llama3.1:8b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Medium",
        "Priority": 1,
        "Temperature": 0.7,
        "MaxTokens": 2048
      },
      {
        "Name": "gemma:2b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Simple",
        "Priority": 1,
        "Temperature": 0.5,
        "MaxTokens": 1024
      },
      {
        "Name": "qwen:32b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Complex",
        "Priority": 1,
        "Temperature": 0.8,
        "MaxTokens": 4096
      },
      {
        "Name": "deepseek-coder:6.7b",
        "BaseUrl": "http://localhost:11434/v1",
        "Complexity": "Expert",
        "Priority": 1,
        "Temperature": 0.3,
        "MaxTokens": 2048
      }
    ]
  },
  "VectorMemoryOptions": {
    "QdrantUrl": "http://localhost:6333",
    "CollectionName": "infernal_facts",
    "VectorDimensions": 384,
    "Enabled": false
  },
  "OnnxEmbeddingOptions": {
    "Enabled": false,
    "ModelPath": "./models/sentence-transformers/model.onnx",
    "TokenizerPath": "./models/sentence-transformers/tokenizer.json",
    "MaxSequenceLength": 128,
    "EmbeddingDimension": 384
  },
  "MemoryPruningOptions": {
    "Enabled": false,
    "PruningIntervalHours": 24,
    "RetentionDays": 30,
    "MinConfidenceThreshold": 0.3,
    "EnableArchival": false,
    "ArchivePath": "./archive/memory"
  }
}
