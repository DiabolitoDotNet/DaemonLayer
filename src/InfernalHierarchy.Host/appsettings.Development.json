{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Information"
      }
    }
  },
  "Ollama": {
    "Temperature": 0.8,
    "MaxTokens": 4096
  },
  "Hierarchy": {
    "MaxAgentDepth": 5
  },
  "ResourceLimits": {
    "MaxTotalAgents": 200,
    "MaxToolExecutionTimeSeconds": 600
  }
}
